@model StudentManagementMvc.Models.StudentAddVm



<h2>Add Student</h2>




<form asp-action="Create"
      method="post">



    <div class="mb-3">


        <label asp-for="StudentName"></label>


        <input asp-for="StudentName"
               class="form-control" />


    </div>





    <div class="mb-3">


        <label asp-for="StudentId">
            Student ID
        </label>


        <input asp-for="StudentId"
               class="form-control" />


    </div>






    <div class="mb-3">


        <label>
            Department
        </label>



        <select asp-for="DepartmentId"
                class="form-control">



            <option>
                Select Department
            </option>



            @foreach (var department in Model.Departments)
            {

                <option value="@department.Id">

                    @department.DepartmentName

                </option>


            }


        </select>


    </div>






    <button class="btn btn-primary">

        Save

    </button>



</form>