@model IEnumerable<StudentManagementMvc.Entities.Student>


<h2>Students</h2>


<a asp-action="Create"
   class="btn btn-primary">
    Add Student
</a>


<div class="row mt-3 mb-3">

    <div class="col-md-6">

        <form asp-action="SearchById" method="get">

            <div class="input-group">

                <input type="text"
                       name="studentId"
                       class="form-control"
                       placeholder="Search by Student ID" />

                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>

            </div>

        </form>

    </div>

    <div class="col-md-6">

        <form asp-action="SearchByName" method="get">

            <div class="input-group">

                <input type="text"
                       name="name"
                       class="form-control"
                       placeholder="Search by Student Name" />

                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>

            </div>

        </form>

    </div>

</div>
<table class="table mt-3">


    <thead>

        <tr>

            <th>
                Student Name
            </th>


            <th>
                Student ID
            </th>


            <th>
                Department
            </th>


            <th>
                Action
            </th>


        </tr>

    </thead>



    <tbody>


        @foreach (var student in Model)
        {

            <tr>


                <td>
                    @student.StudentName
                </td>



                <td>
                    @student.StudentId
                </td>



                <td>
                    @student.Department.DepartmentName
                </td>




                <td>


                    <a asp-action="AddMarks"
                       asp-route-id="@student.Id"
                       class="btn btn-success">

                        Marks

                    </a>



                    <a asp-action="Edit"
                       asp-route-id="@student.Id"
                       class="btn btn-warning">

                        Edit

                    </a>




                    <a asp-action="Delete"
                       asp-route-id="@student.Id"
                       class="btn btn-danger">

                        Delete

                    </a>


                    <a asp-controller="Result"
                       asp-action="StudentResult"
                       asp-route-id="@student.Id"
                       class="btn btn-info">

                        Result

                    </a>



                </td>


            </tr>


        }


    </tbody>


</table>