@model StudentManagementMvc.Entities.Student



<h2>
    Delete Student
</h2>



<h4>
    Are you sure you want to delete
    @* @student.StudentName? *@
</h4>




<form asp-action="Delete">


    <input asp-for="Id" hidden />



    <button class="btn btn-danger">

        Delete

    </button>




    <a asp-action="Index"
       class="btn btn-secondary">

        Cancel

    </a>



</form>