@model StudentManagementMvc.Models.SubjectCreateVm


<h2>Add Subject</h2>



<form asp-action="Create" method="post">


    <div class="mb-3">

        <label asp-for="SubjectName"></label>

        <input asp-for="SubjectName"
               class="form-control" />

    </div>




    <div class="mb-3">

        <label asp-for="DepartmentId">
            Department
        </label>


        <select asp-for="DepartmentId"
                class="form-control">


            <option value="">
                Select Department
            </option>


            @foreach (var department in Model.Departments)
            {

                <option value="@department.Id">

                    @department.DepartmentName

                </option>

            }


        </select>


    </div>




    <button class="btn btn-primary">
        Save
    </button>


</form>