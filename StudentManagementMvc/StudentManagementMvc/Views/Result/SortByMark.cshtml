@model IEnumerable<StudentManagementMvc.Entities.Student>


<h2 class="mb-4">
    Students Sorted By Mark
</h2>



<table class="table table-bordered table-striped">

    <thead class="table-dark">

        <tr>

            <th>
                Student Name
            </th>


            <th>
                Student ID
            </th>


            <th>
                Average Mark
            </th>

        </tr>

    </thead>



    <tbody>

        @foreach (var student in Model)
        {
            double average = student.StudentSubjects.Any()
                ? student.StudentSubjects.Average(x => x.Mark)
                : 0;


            <tr>

                <td>
                    @student.StudentName
                </td>


                <td>
                    @student.StudentId
                </td>


                <td>
                    @average.ToString("0.00")
                </td>

            </tr>
        }

    </tbody>

</table>



<div class="mt-3">

    <button type="button"
            class="btn btn-secondary"
            onclick="history.back()">

        ← Back

    </button>

</div>