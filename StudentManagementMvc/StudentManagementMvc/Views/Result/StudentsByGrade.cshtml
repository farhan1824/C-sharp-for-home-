@model IEnumerable<StudentManagementMvc.Models.StudentResultVm>


<h2>
    Students By Grade
</h2>



<table class="table">


    <thead>

        <tr>

            <th>
                Student Name
            </th>


            <th>
                Student ID
            </th>


            <th>
                Department
            </th>


            <th>
                Average Mark
            </th>


            <th>
                Grade
            </th>


            <th>
                Status
            </th>

        </tr>

    </thead>



    <tbody>


        @foreach (var student in Model)
        {

            <tr>

                <td>
                    @student.StudentName
                </td>


                <td>
                    @student.StudentId
                </td>


                <td>
                    @student.DepartmentName
                </td>


                <td>
                    @student.AverageMark
                </td>


                <td>
                    @student.Grade
                </td>


                <td>

                    @if (student.IsPassed)
                    {
                        <span class="text-success">
                            Passed
                        </span>
                    }
                    else
                    {
                        <span class="text-danger">
                            Failed
                        </span>
                    }

                </td>


            </tr>

        }


    </tbody>


</table>