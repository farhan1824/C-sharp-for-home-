@model IEnumerable<StudentManagementMvc.Entities.Department>

<h2>Departments</h2>

<a asp-action="Create" class="btn btn-primary">
    Add Department
</a>

<table class="table mt-3">

    <thead>
        <tr>
            <th>
                Department Name
            </th>

            <th>
                Action
            </th>
        </tr>
    </thead>


    <tbody>

        @foreach (var department in Model)
        {
            <tr>

                <td>
                    @department.DepartmentName
                </td>


                <td>

                    <a asp-action="Edit"
                       asp-route-id="@department.Id"
                       class="btn btn-warning">
                        Edit
                    </a>


                    <a asp-action="Delete"
                       asp-route-id="@department.Id"
                       class="btn btn-danger">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>