@model StudentManagementSystem.Models.HighestMarkDepartmentVm

<h2>Highest Mark In Department</h2>


<form asp-action="HighestMarkDepartment" method="post">

    @Html.AntiForgeryToken()

    <select asp-for="Department" class="form-control">

        <option value="">
            Select Department
        </option>


        @foreach (var dept in Model.Departments)
        {
            <option value="@dept">
                @dept
            </option>
        }

    </select>


    <button type="submit" class="btn btn-primary mt-2">
        Show Highest Mark
    </button>
    <a asp-action="Index" class="btn btn-danger mt-2">Back</a>

</form>



@if (Model.TopStudent != null)
{
    <hr />

    <h4>
        Highest Mark Student in @Model.Department
    </h4>


    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Name</th>
                <th>Department</th>
                <th>Mark</th>
                <th>Grade</th>
                <th>Status</th>
            </tr>
        </thead>


        <tbody>

            <tr>
                <td>@Model.TopStudent.StudentName</td>
                <td>@Model.TopStudent.Department</td>
                <td>@Model.TopStudent.Mark</td>
                <td>@Model.TopStudent.Grade</td>

                <td>
                    @(Model.TopStudent.IsPassed ? "Passed" : "Failed")
                </td>
            </tr>

        </tbody>

    </table>
}
