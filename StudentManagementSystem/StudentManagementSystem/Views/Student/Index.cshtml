@model IEnumerable<StudentManagementSystem.Entities.Student>

@{
    ViewData["Title"] = "Students";
}

<h2>Student List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Student</a>
    <a asp-action="PassedStudents" class="btn btn-success">Passed Students</a>
    <a asp-action="Statistics" class="btn btn-info">Statistics</a>
    <a asp-action="TopPerformer" class="btn btn-warning">Top Performer</a>
    <a asp-action="SortByMarks" class="btn btn-secondary">Sort By Marks</a>
    <a asp-action="SortByDepartment"class="btn btn-info">Sort By Department</a>
    <a asp-action="HighestMarkDepartment" class="btn btn-warning">Highest Mark Department</a>
</p>

<form asp-action="SearchByName" method="get" class="mb-3">
    <input type="text" name="name" class="form-control" placeholder="Search by Name" />
    <button class="btn btn-primary mt-2">Search</button>
</form>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Department</th>
            <th>Mark</th>
            <th>Grade</th>
            <th>Passed</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.StudentName</td>
                <td>@item.Department</td>
                <td>@item.Mark</td>
                <td>@item.Grade</td>
                <td>@item.IsPassed</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>

                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>

</table>