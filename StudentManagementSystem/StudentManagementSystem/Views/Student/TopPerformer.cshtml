@model StudentManagementSystem.Entities.Student

@{
    ViewData["Title"] = "Top Performer";
}

<h2>@ViewData["Title"]</h2>


@if (Model != null)
{
    <table class="table table-bordered table-striped">

        <tbody>

            <tr>
                <th>Name</th>
                <td>@Model.StudentName</td>
            </tr>


            <tr>
                <th>Department</th>
                <td>@Model.Department</td>
            </tr>


            <tr>
                <th>Mark</th>
                <td>@Model.Mark</td>
            </tr>


            <tr>
                <th>Grade</th>
                <td>@Model.Grade</td>
            </tr>


            <tr>
                <th>Status</th>
                <td>
                    @if (Model.IsPassed)
                    {
                        <span class="badge bg-success">
                            Passed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Failed
                        </span>
                    }
                </td>
            </tr>

        </tbody>

    </table>
}
else
{
    <div class="alert alert-warning">
        No student data available.
    </div>
}


<a asp-action="Index" class="btn btn-primary">
    Back
</a>