@model StudentManagementSystem.Models.StudentDetailsVm

@{
    ViewData["Title"] = "Student Details";
}

<h2>@ViewData["Title"]</h2>


<table class="table table-bordered table-striped">

    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>


    <tr>
        <th>Name</th>
        <td>@Model.StudentName</td>
    </tr>


    <tr>
        <th>Department</th>
        <td>@Model.Department</td>
    </tr>


    <tr>
        <th>Mark</th>
        <td>@Model.Mark</td>
    </tr>


    <tr>
        <th>Grade</th>
        <td>@Model.Grade</td>
    </tr>


    <tr>
        <th>Status</th>
        <td>
            @if (Model.IsPassed)
            {
                <span class="badge bg-success">
                    Passed
                </span>
            }
            else
            {
                <span class="badge bg-danger">
                    Failed
                </span>
            }
        </td>
    </tr>

</table>


<a asp-action="Index" class="btn btn-secondary">
    Back
</a>