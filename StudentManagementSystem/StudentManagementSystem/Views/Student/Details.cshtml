@model StudentManagementSystem.Models.StudentDetailsVm

<h2>Student Details</h2>

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.StudentName</td>
    </tr>

    <tr>
        <th>Department</th>
        <td>@Model.Department</td>
    </tr>

    <tr>
        <th>Mark</th>
        <td>@Model.Mark</td>
    </tr>

    <tr>
        <th>Grade</th>
        <td>@Model.Grade</td>
    </tr>

    <tr>
        <th>Passed</th>
        <td>@Model.IsPassed</td>
    </tr>

</table>

<a asp-action="Index" class="btn btn-secondary">Back</a>