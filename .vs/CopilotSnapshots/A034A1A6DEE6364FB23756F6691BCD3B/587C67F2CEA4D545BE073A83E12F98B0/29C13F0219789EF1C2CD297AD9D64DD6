@model Portfolio.Models.ProfileViewVm

@{
    ViewData["Title"] = "My Portfolio";
}

<style>
    body {
        background-color: #f4f6f9;
    }

    .profile-header {
        background: linear-gradient(135deg, #2563eb, #1e40af);
        color: white;
        padding: 40px;
        border-radius: 15px;
        margin-bottom: 30px;
        box-shadow: 0 5px 15px rgba(0,0,0,.15);
    }

    .section-card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 3px 10px rgba(0,0,0,.08);
    }

    .section-title {
        color: #1e40af;
        font-weight: 700;
        margin-bottom: 20px;
        border-bottom: 3px solid #2563eb;
        padding-bottom: 10px;
    }

    .skill-badge {
        background: #2563eb;
        color: white;
        padding: 10px 18px;
        border-radius: 25px;
        margin: 5px;
        display: inline-block;
        font-size: 14px;
    }

    .timeline-item {
        border-left: 4px solid #2563eb;
        padding-left: 20px;
        margin-bottom: 20px;
    }

    .timeline-title {
        font-weight: 600;
        color: #1e293b;
    }

    .timeline-subtitle {
        color: #64748b;
        font-size: 14px;
    }

    .info-item {
        margin-bottom: 12px;
    }

    .info-label {
        font-weight: bold;
        color: #334155;
    }

    .experience-card {
        border-left: 5px solid #2563eb;
        transition: .3s;
    }

            .experience-card:hover {
                    transform: translateY(-3px);
                }

            .back-link-section {
                margin-top: 30px;
                padding-top: 20px;
                border-top: 1px dashed #e2e8f0;
            }

            .back-link {
                display: inline-block;
                padding: 10px 20px;
                background: #2563eb;
                color: white;
                border-radius: 8px;
                text-decoration: none;
                transition: 0.3s;
            }

            .back-link:hover {
                background: #1e40af;
                text-decoration: none;
                transform: translateY(-2px);
            }
        </style>

<div class="container py-5">

    <!-- Profile Header -->
    <div class="profile-header">
        <h1>@Model.PersonalInfo?.FullName</h1>

        <p class="mb-1">
            <strong>Email:</strong> @Model.PersonalInfo?.Email
        </p>

        <p class="mb-1">
            <strong>Phone:</strong> @Model.PersonalInfo?.Phone
        </p>

        <p class="mb-0">
            <strong>Address:</strong> @Model.PersonalInfo?.Address
        </p>
    </div>

    <!-- Skills -->
    <div class="section-card">
        <h3 class="section-title">Skills</h3>

        @if (Model.Skills.Any())
        {
            @foreach (var skill in Model.Skills)
            {
                <span class="skill-badge">@skill.Name</span>
            }
        }
        else
        {
            <p>No skills available.</p>
        }
    </div>

    <!-- Education -->
    <div class="section-card">
        <h3 class="section-title">Education</h3>

        @if (Model.Education.Any())
        {
            @foreach (var edu in Model.Education)
            {
                <div class="timeline-item">
                    <div class="timeline-title">
                        @edu.Degree
                    </div>

                    <div class="timeline-subtitle">
                        @edu.Institution
                    </div>

                    <div>
                        @edu.Year
                    </div>
                </div>
            }
        }
        else
        {
            <p>No education records available.</p>
        }
    </div>

    <!-- Experience -->
    <div class="section-card">
        <h3 class="section-title">Experience</h3>

        @if (Model.Experience.Any())
        {
            @foreach (var exp in Model.Experience)
            {
                <div class="card experience-card mb-3">
                    <div class="card-body">
                        <h5>@exp.JobTitle</h5>

                        <h6 class="text-muted">
                            @exp.CompanyName
                        </h6>

                        <p class="mt-3">
                            @exp.Description
                        </p>
                    </div>
                </div>
            }
        }
        else
        {
            <p>No experience records available.</p>
        }
    </div>

    <!-- Back to List -->
    <div class="back-link-section text-center">
        <a asp-action="Index" class="back-link">← Back to Dashboard</a>
    </div>

</div>