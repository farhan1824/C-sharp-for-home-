                <input asp-for="GitHub" class="form-control" />
                <span asp-validation-for="GitHub" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Bio" class="control-label"></label>
                <input asp-for="Bio" class="form-control" />
