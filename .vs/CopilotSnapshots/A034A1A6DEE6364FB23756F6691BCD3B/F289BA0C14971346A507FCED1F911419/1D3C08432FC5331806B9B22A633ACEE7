  .personal-edit-container { max-width: 920px; margin: 0.75rem auto; border-radius: 10px; box-shadow: 0 6px 18px rgba(18,38,63,0.04); }
  .personal-edit-container .form-group { margin-bottom: 1rem; }
  .personal-edit-container .form-control { border-radius: 8px; padding: 0.6rem 0.75rem; border: 1px solid #dfe6ee; }
  .personal-edit-container .form-control:focus { box-shadow: 0 0 0 4px rgba(27,110,194,0.06); border-color: #1b6ec2; }
  .personal-edit-container .control-label { font-weight: 600; color: #2c3e50; margin-bottom: 0.4rem; display:block; }
  .personal-edit-container .text-danger { color: #b00020; }
  .personal-edit-container .btn-primary { border-radius: 8px; padding: 0.55rem 0.9rem; }
  .personal-edit-container .btn-secondary { border-radius: 8px; }
  .personal-edit-container .back-link { color: #1b6ec2; text-decoration: none; }
  .personal-edit-container .back-link:hover { text-decoration: underline; }
  @media (max-width: 768px) { .personal-edit-container { margin: 0.5rem; padding: 0.5rem; } .col-md-4 { width: 100%; max-width: 100%; } }
</style>
<div class="row">
    <div class="col-md-4 personal-edit-container">
        <form asp-action="Edit" class="personal-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
