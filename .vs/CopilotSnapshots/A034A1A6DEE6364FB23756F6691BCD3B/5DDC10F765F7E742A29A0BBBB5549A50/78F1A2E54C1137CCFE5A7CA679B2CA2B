@model Portfolio.Models.PersonalinfoVm

@{
    ViewData["Title"] = "Create Personal Info";
}

<h1 class="mb-3">Create Personal Info</h1>

<style>
  /* PersonalInfo Create view scoped styles */
  .personal-card { max-width: 920px; margin: 0.75rem auto; border-radius: 10px; box-shadow: 0 6px 18px rgba(18,38,63,0.05); }
  .personal-card .card-body { padding: 1.25rem; }
  .personal-card .form-label { font-weight: 600; color: #2c3e50; }
  .personal-card .form-control { border-radius: 8px; padding: 0.6rem 0.75rem; border: 1px solid #dfe6ee; }
  .personal-card .form-control:focus { box-shadow: 0 0 0 4px rgba(27,110,194,0.06); border-color: #1b6ec2; }
  .personal-card .text-danger { color: #b00020; }
  .personal-card .border.rounded.p-2 { background: #fafbfd; }
  #previewImg { width: 100%; height: 100%; object-fit: cover; display:block; }
  .personal-card .card-footer { background: transparent; border-top: 1px dashed #eef3f7; }
  .personal-card .btn-primary { border-radius: 8px; padding: 0.55rem 0.9rem; }
  .personal-card .btn-secondary { border-radius: 8px; }

  /* file input tweaks */
  .personal-card input[type="file"] { padding: 6px 8px; }

  @media (max-width: 768px) {
    .personal-card { margin: 0.5rem; }
    .personal-card .card-body { padding: 0.9rem; }
    .personal-card .col-md-6, .personal-card .col-12 { width: 100%; max-width: 100%; }
    .personal-card .d-flex.align-items-center { justify-content: flex-start; }
  }
</style>

<div class="card">
    <div class="card-body">
        <form asp-controller="PersonalInfo" asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @* Hidden Id and ProfileImageUrl (set after upload) *@
            
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Senior Developer" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" placeholder="(+1) 555-555-5555" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" placeholder="City, Country, Street..." />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Website" class="form-label"></label>
                    <input asp-for="Website" class="form-control" placeholder="https://your-site.com" />
                    <span asp-validation-for="Website" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="LinkedIn" class="form-label"></label>
                    <input asp-for="LinkedIn" class="form-control" placeholder="https://linkedin.com/in/yourname" />
                    <span asp-validation-for="LinkedIn" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="GitHub" class="form-label"></label>
                    <input asp-for="GitHub" class="form-control" placeholder="https://github.com/yourname" />
                    <span asp-validation-for="GitHub" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Bio" class="form-label"></label>
                    <textarea asp-for="Bio" class="form-control" rows="5" placeholder="A short bio or summary"></textarea>
                    <span asp-validation-for="Bio" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="profilephoto" class="form-label">Profile photo</label>
                    <input asp-for="profilephoto" class="form-control" type="file" accept="image/*" />
                    <span asp-validation-for="profilephoto" class="text-danger"></span>
                </div>

                <div class="col-md-6 d-flex align-items-center">
                    <div>
                        <label class="form-label">Preview</label>
                        <div class="border rounded p-2" style="width:140px; height:140px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                            <img id="previewImg" src="/images/placeholder-person.png" alt="preview" style="max-width:100%; max-height:100%; object-fit:cover;" />
                        </div>
                    </div>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
    <div class="card-footer text-muted small">
        Tip: You can upload a square image for best results.
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var fileInput = document.querySelector('input[type="file"][asp-for="profilephoto"]') || document.querySelector('input[type="file"][name="profilephoto"]');
            var preview = document.getElementById('previewImg');
            if (!fileInput) {
                // fallback: select first file input
                fileInput = document.querySelector('input[type="file"]');
            }
            if (fileInput && preview) {
                fileInput.addEventListener('change', function (e) {
                    var file = e.target.files && e.target.files[0];
                    if (!file) return;
                    var reader = new FileReader();
                    reader.onload = function (ev) {
                        preview.src = ev.target.result;
                    };
                    reader.readAsDataURL(file);
                });
            }
        })();
    </script>
}
