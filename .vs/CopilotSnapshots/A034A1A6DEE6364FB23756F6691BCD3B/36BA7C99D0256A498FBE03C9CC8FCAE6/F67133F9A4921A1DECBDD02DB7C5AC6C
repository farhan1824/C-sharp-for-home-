<style>
  /* PersonalInfo Delete view styles */
  .personal-delete-container {
    max-width: 920px;
    margin: 1rem auto;
    padding: 1rem 1.25rem;
    background: #fff;
    border: 1px solid #e6e6e6;
    border-radius: 10px;
  }
  .personal-delete-container h1 { margin-top: 0; }
  .personal-delete-container h3 { color: #333; font-weight: 600; }
  .personal-delete-container h4 { margin: 0.5rem 0 0.75rem; color: #555; }
  .details-list dt { font-weight: 700; color: #444; }
  .details-list dd { margin-bottom: 0.75rem; color: #333; }
  .form-actions { display: flex; gap: 0.5rem; margin-top: 1rem; justify-content: flex-end; }
  .form-actions a { align-self: center; color: #1b6ec2; text-decoration: none; padding: 0.35rem 0.6rem; border-radius: 6px; }
  .form-actions a:hover { text-decoration: underline; }
  .btn-danger { background: #d9534f; border-color: #d43f3a; }
  .back-link { color: #1b6ec2; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  @media (max-width: 768px) {
    .personal-delete-container { padding: 0.75rem; }
    .form-actions { flex-direction: column-reverse; align-items: stretch; }
    .form-actions a { text-align: center; }
  }
</style>

