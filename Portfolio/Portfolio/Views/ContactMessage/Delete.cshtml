@model Portfolio.Models.ContactMessageVm

@{
    ViewData["Title"] = "Delete";
}

<style>
  /* Delete confirmation view styles */
  .delete-container {
    max-width: 760px;
    margin: 1rem auto;
    padding: 1rem 1.25rem;
    background: #fff;
    border: 1px solid #e6e6e6;
    border-radius: 8px;
  }
  .delete-container h1 { margin-top: 0; }
  .delete-container h3 { color: #333; font-weight: 600; }
  .delete-container h4 { margin: 0.5rem 0 0.75rem; color: #555; }
  .details-list dt { font-weight: 700; color: #444; }
  .details-list dd { margin-bottom: 0.75rem; color: #333; }
  .form-actions { display: flex; gap: 0.5rem; margin-top: 1rem; justify-content: flex-end; }
  .form-actions a { align-self: center; color: #1b6ec2; text-decoration: none; padding: 0.45rem 0.6rem; border-radius: 6px; }
  .form-actions a:hover { text-decoration: underline; }
  .btn-danger { background: #d9534f; border-color: #d43f3a; }

</style>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Portfolio.Models.ContactMessageVm</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
    </dl>
    <dl class="row">
