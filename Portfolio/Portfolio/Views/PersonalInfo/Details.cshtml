@model Portfolio.Models.ProfileViewVm

@{
    ViewData["Title"] = "Portfolio";
}

<style>
    body {
        background: #f5f7fb;
        font-family: 'Segoe UI', sans-serif;
    }

    .profile-banner {
        background: linear-gradient(135deg, #2563eb, #1e3a8a);
        color: white;
        padding: 50px;
        border-radius: 20px;
        margin-bottom: 30px;
        box-shadow: 0 10px 25px rgba(0,0,0,.15);
    }

    .profile-img {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        object-fit: cover;
        border: 5px solid white;
    }

    .section-card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 3px 15px rgba(0,0,0,.08);
    }

    .section-title {
        color: #2563eb;
        margin-bottom: 20px;
        font-weight: 700;
        border-bottom: 2px solid #e5e7eb;
        padding-bottom: 10px;
    }

    .skill-badge {
        background: #2563eb;
        color: white;
        padding: 8px 15px;
        border-radius: 20px;
        margin: 5px;
        display: inline-block;
    }

    .progress {
        height: 8px;
        margin-top: 5px;
    }

    .timeline {
        border-left: 3px solid #2563eb;
        padding-left: 20px;
        margin-bottom: 20px;
    }

        .timeline h5 {
            margin-bottom: 5px;
        }

    .social-links a {
        text-decoration: none;
        margin-right: 15px;
    }

    .info-label {
        font-weight: 600;
        color: #374151;
    }
</style>

<div class="container py-5">

    <!-- Profile Header -->
    <div class="profile-banner">

        <div class="row align-items-center">

            <div class="col-md-3 text-center">

                @if (!string.IsNullOrEmpty(Model.PersonalInfo?.ProfileImageUrl))
                {
                    <img src="@Model.PersonalInfo.ProfileImageUrl"
                         class="profile-img" />
                }

            </div>

            <div class="col-md-9">

                <h1>@Model.PersonalInfo?.FullName</h1>

                <h4>@Model.PersonalInfo?.Title</h4>

                <p class="mt-3">
                    @Model.PersonalInfo?.Bio
                </p>

                <div class="social-links">
                    <a href="@Model.PersonalInfo?.LinkedIn" target="_blank">LinkedIn</a>
                    <a href="@Model.PersonalInfo?.GitHub" target="_blank">GitHub</a>
                    <a href="@Model.PersonalInfo?.Website" target="_blank">Website</a>
                </div>

            </div>

        </div>

    </div>

    <!-- Personal Information -->
    <div class="section-card">

        <h3 class="section-title">Contact Information</h3>

        <p><span class="info-label">Email:</span> @Model.PersonalInfo?.Email</p>

        <p><span class="info-label">Phone:</span> @Model.PersonalInfo?.Phone</p>

        <p><span class="info-label">Address:</span> @Model.PersonalInfo?.Address</p>

    </div>

    <!-- Skills -->
    <div class="section-card">

        <h3 class="section-title">Skills</h3>

        @foreach (var skill in Model.Skills)
        {
            <div class="mb-3">

                <div class="d-flex justify-content-between">
                    <strong>@skill.Name</strong>
                    <span>@skill.ProficiencyLevel%</span>
                </div>

                <small class="text-muted">@skill.Category</small>

                <div class="progress">
                    <div class="progress-bar"
                         role="progressbar"
                         style="width:@skill.ProficiencyLevel%">
                    </div>
                </div>

            </div>
        }

    </div>

    <!-- Education -->
    <div class="section-card">

        <h3 class="section-title">Education</h3>

        @foreach (var edu in Model.Education)
        {
            <div class="timeline">

                <h5>@edu.Degree</h5>

                <h6 class="text-muted">
                    @edu.Institution
                </h6>

                <p>
                    @edu.FieldOfStudy
                </p>

                <small>
                    @edu.StartDate.ToString("MMM yyyy")
                    -
                    @(edu.EndDate?.ToString("MMM yyyy") ?? "Present")
                </small>

            </div>
        }

    </div>

    <!-- Experience -->
    <div class="section-card">

        <h3 class="section-title">Experience</h3>

        @foreach (var exp in Model.Experience)
        {
            <div class="timeline">

                <h5>@exp.Role</h5>

                <h6 class="text-muted">
                    @exp.Company
                </h6>

                <p>
                    @exp.Description
                </p>

                <small>
                    @exp.StartDate.ToString("MMM yyyy")
                    -
                    @(exp.EndDate?.ToString("MMM yyyy") ?? "Present")
                </small>

            </div>
        }

    </div>

</div>