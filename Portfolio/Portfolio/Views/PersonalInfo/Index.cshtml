@model IEnumerable<Portfolio.Entities.PersonalInfo>

@{
    ViewData["Title"] = "Personal Information";
}

<style>
    body {
        background: #f8fafc;
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        color: #334155;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 16px;
    }

        .page-header h1 {
            color: #0f172a;
            font-weight: 700;
            font-size: 1.75rem;
            margin: 0;
        }

    .create-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: #2563eb;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
    }

        .create-link:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.25);
        }

    /* Grid Layout */
    .profile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 24px;
    }

    /* Card Styling */
    .profile-card {
        background: white;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .profile-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 20px -8px rgba(0,0,0,0.15);
        }

    /* Top Accent / Header in Card */
    .card-banner {
        height: 60px;
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        position: relative;
    }

    .card-body {
        padding: 24px;
        padding-top: 0;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .avatar-wrapper {
        margin-top: -40px;
        margin-bottom: 12px;
        display: flex;
        justify-content: flex-start;
    }

    .profile-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid white;
        background: #f1f5f9;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    }

    .profile-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 4px 0;
    }

    .profile-title {
        font-size: 0.875rem;
        font-weight: 500;
        color: #2563eb;
        background: #eff6ff;
        padding: 4px 10px;
        border-radius: 20px;
        display: inline-block;
        margin-bottom: 16px;
    }

    /* Contact & Meta Fields */
    .info-list {
        list-style: none;
        padding: 0;
        margin: 0 0 16px 0;
        font-size: 0.875rem;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        margin-bottom: 10px;
        color: #475569;
    }

    .info-label {
        font-weight: 600;
        color: #64748b;
        min-width: 75px;
        flex-shrink: 0;
    }

    .info-value {
        word-break: break-all;
    }

    .bio-box {
        background: #f8fafc;
        border-radius: 8px;
        padding: 12px;
        font-size: 0.85rem;
        color: #475569;
        margin-bottom: 20px;
        flex-grow: 1;
        border-left: 3px solid #cbd5e1;
    }

    /* Links / Social Layout */
    .social-links {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
        border-top: 1px dashed #e2e8f0;
        padding-top: 12px;
    }

    .social-btn {
        font-size: 0.8rem;
        font-weight: 600;
        color: #475569;
        text-decoration: none;
        padding: 6px 12px;
        background: #f1f5f9;
        border-radius: 6px;
        transition: background 0.2s;
    }

        .social-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

    /* Action Buttons Footer */
    .card-actions {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        border-top: 1px solid #e2e8f0;
        padding-top: 16px;
    }

    .btn-action {
        text-align: center;
        padding: 8px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s;
    }

    .btn-edit {
        background: #fef3c7;
        color: #d97706;
    }

        .btn-edit:hover {
            background: #fde68a;
        }

    .btn-details {
        background: #dbeafe;
        color: #2563eb;
    }

        .btn-details:hover {
            background: #bfdbfe;
        }

    .btn-delete {
        background: #fee2e2;
        color: #dc2626;
    }

        .btn-delete:hover {
            background: #fecaca;
        }

    .empty-state {
        text-align: center;
        padding: 48px;
        background: white;
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        color: #64748b;
    }
</style>

<div class="page-header">
    <h1>Personal Information</h1>
    <a asp-action="Create" class="create-link">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        Create New
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="profile-grid">
        @foreach (var item in Model)
        {
            <div class="profile-card">
                <div class="card-banner"></div>
                <div class="card-body">
                    <div class="avatar-wrapper">
                        @if (!string.IsNullOrEmpty(item.ProfileImageUrl))
                        {
                            <img src="@item.ProfileImageUrl" alt="@item.FullName" class="profile-img" />
                        }
                        else
                        {
                            <!-- Fallback standard avatar if missing -->
                            <div class="profile-img" style="display:flex; align-items:center; justify-content:center; background:#e2e8f0; color:#64748b; font-weight:bold;">
                                @(string.IsNullOrEmpty(item.FullName) ? "P" : item.FullName.Substring(0, 1))
                            </div>
                        }
                    </div>

                    <h2 class="profile-name">@item.FullName</h2>
                    <div>
                        <span class="profile-title">@item.Title</span>
                    </div>

                    <ul class="info-list">
                        <li class="info-item">
                            <span class="info-label">Email:</span>
                            <span class="info-value">@item.Email</span>
                        </li>
                        <li class="info-item">
                            <span class="info-label">Phone:</span>
                            <span class="info-value">@item.Phone</span>
                        </li>
                        <li class="info-item">
                            <span class="info-label">Address:</span>
                            <span class="info-value">@item.Address</span>
                        </li>
                    </ul>

                    @if (!string.IsNullOrEmpty(item.Bio))
                    {
                        <div class="bio-box">
                            @item.Bio
                        </div>
                    }

                    <div class="social-links">
                        @if (!string.IsNullOrEmpty(item.Website))
                        {
                            <a href="@item.Website" target="_blank" class="social-btn">Website</a>
                        }
                        @if (!string.IsNullOrEmpty(item.LinkedIn))
                        {
                            <a href="@item.LinkedIn" target="_blank" class="social-btn">LinkedIn</a>
                        }
                        @if (!string.IsNullOrEmpty(item.GitHub))
                        {
                            <a href="@item.GitHub" target="_blank" class="social-btn">GitHub</a>
                        }
                    </div>

                    <div class="card-actions">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-details">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-delete">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <h3>No Records Found</h3>
        <p>Get started by clicking the "Create New" button above.</p>
    </div>
}